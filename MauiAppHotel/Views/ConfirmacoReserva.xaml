<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ConfirmacaoReserva"
             Title="Confirmação da Reserva"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F0E8">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20"
                             VerticalOptions="Center">

            <Label Text="MAUI APP HOTEL"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#C5A15B"
                   HorizontalOptions="Center"/>

            <Label Text="Reserva"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#4A382B"
                   HorizontalOptions="Center"/>

            <Label Text="Confira seus dados!"
                   FontSize="16"
                   TextColor="#806044"
                   HorizontalOptions="Center"/>

            <Border Padding="22"
                    BackgroundColor="White"
                    Stroke="#C5A15B"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="18">

                    <Label Text="RESUMO DO HÓSPEDE"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#806044"
                           HorizontalOptions="Center"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#D8C7B2"/>

                    <Label Text="Nome completo:"
                           FontAttributes="Bold"
                           TextColor="#806044"/>

                    <Label x:Name="lblNome"
                           FontSize="16"
                           TextColor="#4A382B"/>

                    <Label Text="Telefone:"
                           FontAttributes="Bold"
                           TextColor="#806044"/>

                    <Label x:Name="lblTelefone"
                           FontSize="16"
                           TextColor="#4A382B"/>

                    <Label Text="E-mail:"
                           FontAttributes="Bold"
                           TextColor="#806044"/>

                    <Label x:Name="lblEmail"
                           FontSize="16"
                           TextColor="#4A382B"/>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#D8C7B2"/>

                    <Label Text="Agradecemos sua preferência!"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#C5A15B"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Seus dados foram recebidos para esta demonstração."
                           FontSize="14"
                           TextColor="#806044"
                           HorizontalTextAlignment="Center"/>

                    <Button Text="FINALIZAR"
                            BackgroundColor="#806044"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="52"
                            Clicked="OnFinalizarClicked"/>

                </VerticalStackLayout>
            </Border>

            <Label Text="MAUI APP HOTEL • 2026"
                   FontSize="12"
                   TextColor="#806044"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
