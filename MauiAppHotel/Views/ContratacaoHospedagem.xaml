<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F0E8">

    <VerticalStackLayout VerticalOptions="Center"
                         Padding="10"
                         Spacing="10">

        <Label Text="Cálculo da Diária"
               FontFamily="Kalam"
               FontSize="40"
               TextColor="#806044"
               HorizontalOptions="Center" />

        <Border Padding="10">

            <VerticalStackLayout Spacing="10">

                <!-- Quantidade de hóspedes -->
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*"
                      RowSpacing="10">

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="Adultos:" />

                    <Label Grid.Row="0"
                           Grid.Column="1"
                           TextColor="#806044"
                           Text="{Binding Value, Source={x:Reference stepperAdultos}}" />

                    <Stepper Grid.Row="0"
                             Grid.Column="2"
                             x:Name="stepperAdultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="Crianças:" />

                    <Label Grid.Row="1"
                           Grid.Column="1"
                           TextColor="#806044"
                           Text="{Binding Value, Source={x:Reference stepperCriancas}}" />

                    <Stepper Grid.Row="1"
                             Grid.Column="2"
                             x:Name="stepperCriancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                </Grid>

                <!-- Escolha da suíte -->
                <Label Text="Escolha sua Suíte"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#806044"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />

                <Picker x:Name="pck_quarto"
                        Title="Selecione sua Acomodação">
                </Picker>

                <!-- Período da estadia -->
                <Border Padding="10"
                        Margin="10">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Período da Estadia"
                               FontAttributes="Bold" />

                        <HorizontalStackLayout>
                            <Label Text="Check-in:"
                                   VerticalOptions="Center" />

                            <DatePicker x:Name="dtpck_checkin"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout>
                            <Label Text="Check-out:"
                                   VerticalOptions="Center" />

                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <Button Text="Avançar"
                                BackgroundColor="#806044"
                                TextColor="White"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                HeightRequest="50"/>
                        <Button Text="Sobre o aplicativo"
                                BackgroundColor="#B49A7C"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnSobreClicked"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </Border>

    </VerticalStackLayout>

</ContentPage>
